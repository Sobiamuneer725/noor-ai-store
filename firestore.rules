rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products catalog: public read and write allowed for app catalog seeding
    match /products/{productId} {
      allow read, write: if true;
    }
    
    // User profiles: allow read/write for authenticated users or public testing
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Orders history: allow read and create for authenticated users or public testing
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Product reviews: allow read and write for interactive community feedback
    match /reviews/{reviewId} {
      allow read, write: if true;
    }
    match /products/{productId}/reviews/{reviewId} {
      allow read, write: if true;
    }

    // AI Concierge conversation logs: allow read/write for persistent chat history
    match /ai_conversations/{docId} {
      allow read, write: if true;
    }
    match /ai_conversations/{docId}/{subDoc=**} {
      allow read, write: if true;
    }
  }
}
